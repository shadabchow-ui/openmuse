{
  "expo": {
    "name": "OpenMuse",
    "slug": "openmuse",
    "scheme": "openmuse",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.openmuse.mobile"
    },
    "android": {
      "package": "app.openmuse.mobile"
    },
    "web": {
      "bundler": "metro",
      "name": "OpenMuse \u2014 a little room for everything"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to lock the app with Face ID."
        }
      ],
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ]
  }
}
